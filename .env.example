# CampusNav Firebase Configuration
# Replace these values with your Firebase Project configuration from the Firebase Console:
# Project Settings -> General -> Your apps -> Web app -> Firebase SDK snippet -> Config

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional: Google Gemini AI API Key for CampusNav AI Assistant
# If not provided, CampusNav uses its built-in Local Campus Context Engine (grounded in LPU locations & live Firestore).
# Get an API key from Google AI Studio: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# Optional: Custom Satellite Imagery Tile Provider URL
# Default uses Esri World Imagery (public high-resolution satellite tiles, no API key required).
# Example: https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_SATELLITE_TILE_URL=


