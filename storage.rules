rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // User profile pictures
    match /users/{userId}/{fileName} {
      // Profile pictures can be publicly viewed
      allow read: if true;
      // Only the authenticated user can upload their profile photo (max 5MB, image only)
      allow write: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    // Lost & Found item photos
    match /lost_found/{fileName} {
      // Item photos can be publicly viewed
      allow read: if true;
      // Authenticated users can upload item photos (max 10MB, image only)
      allow write: if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
  }
}
